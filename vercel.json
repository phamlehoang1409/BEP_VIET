{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite"
    },
    "server": {
      "root": "server",
      "framework": "express",
      "entrypoint": "index.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/socket.io/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "client"
      }
    },
    {
      "source": "/manifest.json",
      "destination": {
        "service": "client"
      }
    },
    {
      "source": "/sw.js",
      "destination": {
        "service": "client"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client",
        "path": "/"
      }
    }
  ]
}
